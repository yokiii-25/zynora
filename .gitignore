# =========================
# ZYNORA Git Ignore
# =========================

# Environment / secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
backend/venv/
backend/.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
frontend/dist/
dist/
.vite/

# Generated outputs
outputs/
backend/outputs/
frontend/outputs/

# AI / ML model files
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx

# HuggingFace / model cache
.cache/
huggingface/
models/

# Blender temporary files
*.blend1
*.blend2
*.blend@
*.blend~
*.autosave

# Render cache / temp
tmp/
temp/
cache/
*.tmp

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Logs
*.log

# Python packaging
build/
*.egg-info/

# Backup folders
backend_old/

# Large generated archives
*.zip
*.7z
*.rar

# Project backups
backups/
backup_exterior_slides_*/
